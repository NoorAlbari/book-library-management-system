<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Add</title>
</head>

<body>
    <%- include('../partials/navbar') %>

        <h1>Add a Book</h1>
        <form action="/new" method="POST">
            <label for="title">Book title:</label>
            <input type="text" name="title" id="street-title" />
            <br>
            <br>

            <label for="description">Book description:</label>
            <input type="text" name="description" id="description" />
            <br>
            <br>

            <label for="categoryName">category:</label>
            <select name="categoryName" id="categoryName">
                <% for(let oneCategory of categories){%>
                    <option value="<%=oneCategory._id%>"><%=oneCategory.categoryName%></option>
                    <%}%>
            </select>
            <br>
            <br>

            <label for="author">Name of Author:</label>
            <input type="text" name="author" id="author"/>
            <br>
            <br>

            <label for="rating">Rating:</label>
            <select name="rating" id="rating">
                <option value="1 Star">1 Star</option>
                <option value="2 Star">2 Star</option>
                <option value="3 Star">3 Star</option>
                <option value="4 Star">4 Star</option>
                <option value="5 Star">5 Star</option>
            </select>
            <br>
            <br>

            <label for="publishYear">Publish Year: </label>
            <input type="text" name="publishYear" id="publishYear"/>
            <br>
            <br>

            <label for="Status">Book Status:</label>
            <select name="Status" id="Status">
                <option value="Borrowed">Borrowed</option>
                <option value="Coming Soon">Coming Soon</option>
                <option value="Available">Available</option>
            </select>
            <br>
            <br>

            <button type="submit">Add</button>
        </form>

</body>

</html>