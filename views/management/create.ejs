<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="../css/style.css">

    <title>Add</title>
</head>

<body>
    <%- include('../partials/navbar') %>

        <h1>Add a Book</h1>
        <form action="/new" method="POST" enctype="multipart/form-data">
            <!-- Put this exactly where you want the file picker to appear -->
            <label for="coverImage">Upload Book Cover:</label>
            <input type="file" id="coverImage" accept="image/*" name="coverImage"/>

            <!-- Container to show success, uploading status, or errors -->
            <div id="statusMessage"></div>
            <br>
            <br>

            <label for="title">Book title:</label>
            <input type="text" name="title" id="title" />
            <br>
            <br>

            <label for="description">Book description:</label>
            <input type="text" name="description" id="description" />
            <br>
            <br>

            <label for="categoryName">category:</label>
            <select name="categoryName" id="categoryName">
                <% for(let oneCategory of categories){%>
                    <option value="<%=oneCategory._id%>">
                        <%=oneCategory.categoryName%>
                    </option>
                    <%}%>
            </select>
            <br>
            <br>

            <label for="author">Name of Author:</label>
            <input type="text" name="author" id="author" />
            <br>
            <br>

            <label for="rating">Rating:</label>
            <select name="rating" id="rating">
                <option value="1">1 Star</option>
                <option value="2">2 Star</option>
                <option value="3">3 Star</option>
                <option value="4">4 Star</option>
                <option value="5">5 Star</option>
            </select>
            <br>
            <br>

            <label for="publishYear">Publish Year: </label>
            <input type="text" name="publishYear" id="publishYear" />
            <br>
            <br>

            <label for="Status">Book Status:</label>
            <select name="Status" id="Status">
                <option value="Borrowed">Borrowed</option>
                <option value="Coming Soon">Coming Soon</option>
                <option value="Available">Available</option>
            </select>
            <br>
            <br>

            <button type="submit">Add</button>
        </form>

</body>

</html>