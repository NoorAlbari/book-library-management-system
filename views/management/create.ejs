<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css">

    <title>Add</title>
</head>

<body>
    <%- include('../partials/navbar') %>

        <h1 class="form-title">Add a Book</h1>
        <!-- Added wrapper class "form-card" to style the entire form -->
        <form action="/new" method="POST" enctype="multipart/form-data" class="form-card">
            
            <!-- Grouped 'Upload' label, input, and message container -->
            <div class="form-group">
                <label for="coverImage" class="form-label">Upload Book Cover:</label>
                <input type="file" id="coverImage" accept="image/*" name="coverImage" class="file-input" />
                <!-- Container to show success, uploading status, or errors -->
                <div id="statusMessage" class="status-msg"></div>
            </div>
            
            <!-- Removing the obsolete standard br break elements since flex grids and margins handle this modern-design -->
            <!-- <br><br> is safely bypassed via modern stylesheet structures but kept if your template strictness needs them untouched -->

            <!-- Grouped 'Book title' label & input -->
            <div class="form-group">
                <label for="title" class="form-label">Book title:</label>
                <input type="text" name="title" id="title" class="form-input" placeholder="Enter the book's title" />
            </div>

            <!-- Grouped 'Book description' label & input -->
            <div class="form-group">
                <label for="description" class="form-label">Book description:</label>
                <input type="text" name="description" id="description" class="form-input" placeholder="Enter the book's description" />
            </div>

            <!-- Grouped 'Category' label & custom select dropdown -->
            <div class="form-group">
                <label for="categoryName" class="form-label">Category:</label>
                <div class="select-wrapper">
                    <select name="categoryName" id="categoryName" class="form-select">
                        <% for(let oneCategory of categories){%>
                            <option value="<%=oneCategory._id%>">
                                <%=oneCategory.categoryName%>
                            </option>
                        <%}%>
                    </select>
                </div>
            </div>

            <!-- Grouped 'Author Name' label & input -->
            <div class="form-group">
                <label for="author" class="form-label">Name of Author:</label>
                <input type="text" name="author" id="author" class="form-input" placeholder="Enter author's name" />
            </div>

            <!-- Grouped 'Rating' label & select dropdown -->
            <div class="form-group">
                <label for="rating" class="form-label">Rating:</label>
                <div class="select-wrapper">
                    <select name="rating" id="rating" class="form-select">
                        <option value="1">1 Star</option>
                        <option value="2">2 Star</option>
                        <option value="3">3 Star</option>
                        <option value="4">4 Star</option>
                        <option value="5">5 Star</option>
                    </select>
                </div>
            </div>

            <!-- Grouped 'Publish Year' label & input -->
            <div class="form-group">
                <label for="publishYear" class="form-label">Publish Year:</label>
                <input type="text" name="publishYear" id="publishYear" class="form-input" placeholder="e.g. 2026" />
            </div>

            <!-- Grouped 'Book Status' label & custom dropdown -->
            <div class="form-group">
                <label for="Status" class="form-label">Book Status:</label>
                <div class="select-wrapper">
                    <select name="Status" id="Status" class="form-select">
                        <option value="Borrowed">Borrowed</option>
                        <option value="Coming Soon">Coming Soon</option>
                        <option value="Available">Available</option>
                    </select>
                </div>
            </div>

            <!-- Added action class "form-actions" & modernized "btn" design -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>

</body>

</html>