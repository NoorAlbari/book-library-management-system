<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css">
    <script defer src="../js/search-bar.js"></script>
    <script defer src="../js/popup.js"></script>
    <title>Dashboard</title>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="shelf-section">

            <!-- Available Books -->
             <div class="shelf-header">
                    <h2 class="shelf-title">Available Books</h2>
                    <a href="/full-shelf/Available" class="shelf-link">Full shelf &rarr;</a>
                </div>

            <div class="shelf">

                
                <% for (let oneBook of books) { %>

                    <% if(oneBook.Status==='Available' ) { %>

                        <div class="book">

                            <img class="book-image" src="<%= oneBook.coverImage %>" data-id="<%= oneBook._id %>"
                                data-title="<%= oneBook.title %>" data-description="<%= oneBook.description %>"
                                data-category="<%= oneBook.categoryName.categoryName %>"
                                data-author="<%= oneBook.author %>" data-rating="<%= oneBook.rating %>"
                                data-year="<%= oneBook.publishYear %>" data-status="<%= oneBook.Status %>">


                            <form action="/<%= oneBook._id %>?_method=DELETE" method="POST">
                                <button type="submit">Delete</button>
                            </form>

                            <form action="/<%= oneBook._id %>/edit" method="GET">
                                <button type="submit">Edit</button>
                            </form>

                        </div>

                        <% } %>

                            <% } %>

            </div>


            <!-- Coming Soon Books -->
             <div class="shelf-header">
                    <h2 class="shelf-title">Coming Soon</h2>
                    <a href="/full-shelf/Coming Soon" class="shelf-link">Full shelf &rarr;</a>
                </div>
            <div class="shelf">
                
                 

                <% for (let oneBook of books) { %>

                    <% if(oneBook.Status==='Coming Soon' ) { %>

                        <div class="book">

                            <img class="book-image" src="<%= oneBook.coverImage %>" data-id="<%= oneBook._id %>"
                                data-description="<%= oneBook.description %>"
                                data-category="<%= oneBook.categoryName.categoryName %>"
                                data-author="<%= oneBook.author %>" data-rating="<%= oneBook.rating %>"
                                data-year="<%= oneBook.publishYear %>" data-status="<%= oneBook.Status %>">

                            <h2>
                                <%= oneBook.title %>
                            </h2>


                        </div>

                        <% } %>

                            <% } %>

            </div>


            <!-- Borrowed Books -->
            <div class="shelf-header">
                    <h2 class="shelf-title">Borrowed Books</h2>
                    <a href="/full-shelf/Borrowed" class="shelf-link">Full shelf &rarr;</a>
                </div>
            <div class="shelf">
                

                <% for (let oneBook of books) { %>

                    <% if(oneBook.Status==='Borrowed' ) { %>

                        <div class="book">

                            <img class="book-image" src="<%= oneBook.coverImage %>" data-id="<%= oneBook._id %>"
                                data-description="<%= oneBook.description %>"
                                data-category="<%= oneBook.categoryName.categoryName %>"
                                data-author="<%= oneBook.author %>" data-rating="<%= oneBook.rating %>"
                                data-year="<%= oneBook.publishYear %>" data-status="<%= oneBook.Status %>">

                            <h2>
                                <%= oneBook.title %>
                            </h2>


                        </div>

                        <% } %>

                            <% } %>

            </div>

        </div>
<!-- Book Popup -->
<div class="popup" id="book-popup">
    <div class="popup-box">
        <span class="close-popup">&times;</span>

        <!-- Top Section: Book Cover + Meta Column -->
        <div class="popup-top">
            <img id="popup-image" src="" alt="Book Cover">

            <div class="popup-meta-col">
                <div class="popup-title-row">
                    <h2 id="popup-title"></h2>
                    <span class="by-label">by</span>
                    <span id="popup-author"></span>
                </div>

                <span id="popup-category"></span>
                <span id="popup-status"></span>
                
                <div class="popup-rating-wrap">
                    <span class="rating-label">Rating:</span>
                    <span id="popup-rating"></span>
                    <span id="popup-year"></span>
                </div>
            </div>
        </div>

        <!-- Middle Section: Description Box -->
        <div class="popup-desc-box">
            <h4>Description</h4>
            <p id="popup-description"></p>
        </div>

        <!-- Bottom Section: Actions Row -->
        <div class="popup-actions-row">
            <form id="edit-form" method="GET">
                <button type="submit">Edit</button>
            </form>
            <form id="delete-form" method="POST">
                <button type="submit">Delete</button>
            </form>
        </div>
    </div>
</div>

</body>

</html>