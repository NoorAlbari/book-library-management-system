<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/style.css">
    <title>Home</title>
</head>

<body>

    <h1>Welcome to my Website</h1>

    <%- include('../partials/navbar') %>
        <h1 class="form-title">Edit Book</h1>


        <form action="/<%= books._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="form-card">
            <div class="form-group">
                <label for="coverImage" class="form-label">Change Book Cover:</label>
                <input type="file" id="coverImage" accept="image/*" name="coverImage" value="<%= books.coverImage %>"
                    class="file-input" />
            </div>


            <div class="form-group">
                <label for="title">Book title:</label>
                <input type="text" name="title" id="title" value="<%= books.title %>" class="form-input" />
            </div>


            <div class="form-group">
                <label for="description">Book description:</label>
                <input type="text" name="description" id="description" value="<%= books.description %>"
                    class="form-input" />
            </div>


            <div class="form-group">
                <label for="categoryName">category:</label>
                <select name="categoryName" id="categoryName" class="form-select">
                    <% for(let oneCategory of categories){%>
                        <option value="<%=oneCategory._id%>" <%
                            if(books.categoryName._id.toString()===oneCategory._id.toString()) { %>
                            selected
                            <% } %>><%=oneCategory.categoryName%>
                        </option>
                        <%}%>
                </select>

            </div>


            <div class="form-group">
                <label for="author">Name of Author:</label>
                <input type="text" name="author" id="author" value="<%= books.author %>" class="form-input" />
            </div>



            <div class="form-group">
                <label for="rating">Rating:</label>
                <select name="rating" id="rating" class="form-select">
                    <option value="1" <% if(books.rating===1 ){%> selected <%} %>>1 Star</option>
                    <option value="2" <% if(books.rating===2 ){%> selected <%} %>>2 Star</option>
                    <option value="3" <% if(books.rating===3 ){%> selected <%} %>>3 Star</option>
                    <option value="4" <% if(books.rating===4 ){%> selected <%} %>>4 Star</option>
                    <option value="5" <% if(books.rating===5 ){%> selected <%} %>>5 Star</option>
                </select>
            </div>


            <div class="form-group">
                <label for="publishYear">Publish Year: </label>
                <input type="text" name="publishYear" id="publishYear" value="<%= books.publishYear %>"
                    class="form-input" />
            </div>


            <div class="form-group">
                <label for="Status">Book Status:</label>
                <select name="Status" id="Status" class="form-select">
                    <option value="Borrowed" <% if(books.Status==='Borrowed' ){%> selected <%}%>>Borrowed</option>
                    <option value="Coming Soon" <% if(books.Status==='Coming Soon' ){%> selected <%} %>>Coming Soon
                    </option>
                    <option value="Available" <% if(books.Status==='Available' ){%> selected <%} %>>Available</option>
                </select>

            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>


            </div>
        </form>

</body>

</html>